<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cron_created_by_form" model="ir.ui.view">
        <field name="name">view_cron_created_by</field>
        <field name="model">ir.cron.trigger</field>
        <field name="inherit_id" ref="base.ir_cron_trigger_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='call_at']" position="after">
                <field name="create_uid"/>
            </xpath>
        </field>
    </record>

    <record id="view_cron_created_by_tree" model="ir.ui.view">
        <field name="name">view_cron_created_by_tree</field>
        <field name="model">ir.cron.trigger</field>
        <field name="inherit_id" ref="base.ir_cron_trigger_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='call_at']" position="before">
                <field name="create_uid"/>
            </xpath>
        </field>
    </record>


</odoo>