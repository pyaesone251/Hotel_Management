<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reservation Report Action -->
    <record id="action_report_hotel_reservation" model="ir.actions.report">
        <field name="name">Reservation Confirmation</field>
        <field name="model">hotel.reservation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management.report_hotel_reservation</field>
        <field name="report_file">hotel_management.report_hotel_reservation</field>
        <field name="binding_model_id" ref="model_hotel_reservation"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Folio Report Action -->
    <record id="action_report_hotel_folio" model="ir.actions.report">
        <field name="name">Hotel Folio</field>
        <field name="model">hotel.folio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management.report_hotel_folio</field>
        <field name="report_file">hotel_management.report_hotel_folio</field>
        <field name="binding_model_id" ref="model_hotel_folio"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
