<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Menu -->
    <menuitem id="hotel_menu_root"
              name="Hotel"
              web_icon="hotel_management,static/description/icon.png"
              sequence="100"/>

    <!-- Dashboard -->
    <menuitem id="hotel_menu_dashboard"
              name="Dashboard"
              parent="hotel_menu_root"
              action="hotel_dashboard_action"
              sequence="1"/>

    <!-- Front Desk -->
    <menuitem id="hotel_menu_front_desk"
              name="Front Desk"
              parent="hotel_menu_root"
              sequence="10"/>

    <menuitem id="hotel_menu_reservation"
              name="Reservations"
              parent="hotel_menu_front_desk"
              action="hotel_reservation_action"
              sequence="1"/>

    <menuitem id="hotel_menu_today_checkin"
              name="Today's Check-ins"
              parent="hotel_menu_front_desk"
              action="hotel_today_checkin_action"
              sequence="2"/>

    <menuitem id="hotel_menu_today_checkout"
              name="Today's Check-outs"
              parent="hotel_menu_front_desk"
              action="hotel_today_checkout_action"
              sequence="3"/>

    <menuitem id="hotel_menu_guest"
              name="Guests"
              parent="hotel_menu_front_desk"
              action="hotel_guest_action"
              sequence="4"/>

    <!-- Rooms -->
    <menuitem id="hotel_menu_rooms"
              name="Rooms"
              parent="hotel_menu_root"
              sequence="20"/>

    <menuitem id="hotel_menu_all_rooms"
              name="All Rooms"
              parent="hotel_menu_rooms"
              action="hotel_room_action"
              sequence="1"/>

    <menuitem id="hotel_menu_available_rooms"
              name="Available Rooms"
              parent="hotel_menu_rooms"
              action="hotel_available_rooms_action"
              sequence="2"/>

    <!-- Billing -->
    <menuitem id="hotel_menu_billing"
              name="Billing"
              parent="hotel_menu_root"
              sequence="30"/>

    <menuitem id="hotel_menu_folio"
              name="Folios"
              parent="hotel_menu_billing"
              action="hotel_folio_action"
              sequence="1"/>

    <!-- Configuration -->
    <menuitem id="hotel_menu_config"
              name="Configuration"
              parent="hotel_menu_root"
              groups="group_hotel_manager"
              sequence="100"/>

    <menuitem id="hotel_menu_room_type"
              name="Room Types"
              parent="hotel_menu_config"
              action="hotel_room_type_action"
              sequence="1"/>

    <menuitem id="hotel_menu_service"
              name="Services"
              parent="hotel_menu_config"
              action="hotel_service_action"
              sequence="2"/>

</odoo>
