<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Room Type Tree View -->
    <record id="hotel_room_type_view_list" model="ir.ui.view">
        <field name="name">hotel.room.type.list</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="base_price" widget="monetary"/>
                <field name="max_adults"/>
                <field name="max_children"/>
                <field name="room_count"/>
            </list>
        </field>
    </record>

    <!-- Room Type Form View -->
    <record id="hotel_room_type_view_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Deluxe Suite"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="base_price" widget="monetary"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="max_adults"/>
                            <field name="max_children"/>
                            <field name="room_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="Describe this room type..."/>
                        </page>
                        <page string="Amenities" name="amenities">
                            <field name="amenities"
                                   placeholder="List amenities..."/>
                        </page>
                        <page string="Rooms" name="rooms">
                            <field name="room_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="floor"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-danger="state == 'occupied'"
                                           decoration-warning="state == 'maintenance'"
                                           decoration-info="state == 'cleaning'"/>
                                    <field name="price_per_night" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Room Type Kanban View -->
    <record id="hotel_room_type_view_kanban" model="ir.ui.view">
        <field name="name">hotel.room.type.kanban</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="base_price"/>
                <field name="room_count"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="col-4 text-end">
                                <field name="base_price" widget="monetary"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6 text-muted">
                                Code: <field name="code"/>
                            </div>
                            <div class="col-6 text-end text-muted">
                                <field name="room_count"/> rooms
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Room Type Action -->
    <record id="hotel_room_type_action" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Room Type
            </p>
            <p>
                Define room categories with pricing and amenities.
            </p>
        </field>
    </record>

</odoo>
