<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Action (Reservations filtered for today) -->
    <record id="hotel_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">kanban,list,calendar</field>
        <field name="context">{
            'search_default_group_state': 1,
        }</field>
        <field name="domain">[('state', 'not in', ['cancelled'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to Hotel Management
            </p>
            <p>
                Start by creating rooms and accepting reservations.
            </p>
        </field>
    </record>

    <!-- Today's Check-ins Action -->
    <record id="hotel_today_checkin_action" model="ir.actions.act_window">
        <field name="name">Today's Check-ins</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today_checkin': 1}</field>
    </record>

    <!-- Today's Check-outs Action -->
    <record id="hotel_today_checkout_action" model="ir.actions.act_window">
        <field name="name">Today's Check-outs</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today_checkout': 1}</field>
    </record>

    <!-- Available Rooms Action -->
    <record id="hotel_available_rooms_action" model="ir.actions.act_window">
        <field name="name">Available Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

</odoo>
