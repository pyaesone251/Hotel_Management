<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reservation Tree View -->
    <record id="hotel_reservation_view_list" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'"
                  decoration-success="state == 'checkin'"
                  decoration-muted="state in ('checkout', 'cancelled')">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="room_type_id"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="duration"/>
                <field name="adults"/>
                <field name="grand_total" widget="monetary" sum="Total"/>
                <field name="source"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'checkin'"
                       decoration-muted="state == 'checkout'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Reservation Form View -->
    <record id="hotel_reservation_view_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_checkin" string="Check In"
                            type="object" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_checkout" string="Check Out"
                            type="object" class="btn-primary"
                            invisible="state != 'checkin'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('checkout', 'cancelled')"
                            confirm="Are you sure you want to cancel this reservation?"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checkin,checkout"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_folio" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not folio_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Folio</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Information">
                            <field name="guest_id"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="source"/>
                        </group>
                        <group string="Room Information">
                            <field name="room_id"
                                   domain="[('state', '=', 'available')]"
                                   options="{'no_create': True}"/>
                            <field name="room_type_id" readonly="1"/>
                            <field name="adults"/>
                            <field name="children"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="checkin_date"/>
                            <field name="checkout_date"/>
                            <field name="duration"/>
                        </group>
                        <group string="Pricing">
                            <field name="price_per_night" widget="monetary"/>
                            <field name="discount"/>
                            <field name="total_room_charge" widget="monetary"/>
                            <field name="total_service_charge" widget="monetary"/>
                            <field name="grand_total" widget="monetary"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="services">
                            <field name="service_line_ids">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="date"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Special Requests" name="requests">
                            <field name="special_requests"
                                   placeholder="Enter any special requests from the guest..."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Reservation Kanban View -->
    <record id="hotel_reservation_view_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="state"/>
                <field name="grand_total"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bolder"/>
                        <field name="guest_id"/>
                        <div>
                            <i class="fa fa-bed"/> <field name="room_id"/>
                        </div>
                        <div class="text-muted small">
                            <i class="fa fa-calendar"/>
                            <field name="checkin_date" widget="date"/>
                            →
                            <field name="checkout_date" widget="date"/>
                        </div>
                        <div class="mt-1">
                            <field name="grand_total" widget="monetary"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Reservation Calendar View -->
    <record id="hotel_reservation_view_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations"
                      date_start="checkin_date"
                      date_stop="checkout_date"
                      color="room_id"
                      mode="month"
                      quick_create="0"
                      event_open_popup="1">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Reservation Search View -->
    <record id="hotel_reservation_view_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="room_type_id"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter string="Checked In" name="checkin"
                        domain="[('state', '=', 'checkin')]"/>
                <filter string="Checked Out" name="checkout"
                        domain="[('state', '=', 'checkout')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Today's Check-in" name="today_checkin"
                        domain="[('checkin_date', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                                 ('checkin_date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Today's Check-out" name="today_checkout"
                        domain="[('checkout_date', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
                                 ('checkout_date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Guest" name="group_guest"
                            context="{'group_by': 'guest_id'}"/>
                    <filter string="Room" name="group_room"
                            context="{'group_by': 'room_id'}"/>
                    <filter string="Room Type" name="group_room_type"
                            context="{'group_by': 'room_type_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Check-in Month" name="group_checkin"
                            context="{'group_by': 'checkin_date:month'}"/>
                    <filter string="Source" name="group_source"
                            context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Reservation Action -->
    <record id="hotel_reservation_action" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Reservation
            </p>
            <p>
                Manage hotel bookings from draft to check-out.
            </p>
        </field>
    </record>

</odoo>
