<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Service Tree View -->
    <record id="hotel_service_view_list" model="ir.ui.view">
        <field name="name">hotel.service.list</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="price" widget="monetary"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Service Form View -->
    <record id="hotel_service_view_form" model="ir.ui.view">
        <field name="name">hotel.service.form</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Breakfast Buffet"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                            <field name="active"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"
                               placeholder="Describe this service..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Service Search View -->
    <record id="hotel_service_view_search" model="ir.ui.view">
        <field name="name">hotel.service.search</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <separator/>
                <filter string="Room Service" name="room_service"
                        domain="[('category', '=', 'room_service')]"/>
                <filter string="Food &amp; Beverage" name="food"
                        domain="[('category', '=', 'food')]"/>
                <filter string="Laundry" name="laundry"
                        domain="[('category', '=', 'laundry')]"/>
                <filter string="Transport" name="transport"
                        domain="[('category', '=', 'transport')]"/>
                <filter string="Spa &amp; Wellness" name="spa"
                        domain="[('category', '=', 'spa')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Service Action -->
    <record id="hotel_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hotel.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first Hotel Service
            </p>
            <p>
                Create services like room service, laundry, spa, etc.
            </p>
        </field>
    </record>

</odoo>
