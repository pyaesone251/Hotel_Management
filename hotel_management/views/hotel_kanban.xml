<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== -->
    <!--     HOTEL ROOM KANBAN VIEW     -->
    <!-- ============================== -->

    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    records_draggable="1" group_create="0">
                <field name="name"/>
                <field name="room_type"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="price_per_night"/>
                <field name="state"/>
                <field name="booking_count"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image" t-if="record.image.raw_value">
                            <img t-att-src="kanban_image('hotel.room', 'image', record.id.raw_value)"
                                 alt="Room" class="o_image_64_cover"/>
                        </div>
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {
                                           'available': 'success',
                                           'occupied': 'danger',
                                           'maintenance': 'warning'
                                       }}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>Type:</strong>
                                    <field name="room_type"/>
                                </div>
                                <div>
                                    <strong>Floor:</strong>
                                    <field name="floor"/>
                                    <span class="ms-2">
                                        <strong>Capacity:</strong>
                                        <field name="capacity"/>
                                    </span>
                                </div>
                                <div>
                                    <strong>Price:</strong>
                                    <field name="price_per_night" widget="monetary"/>
                                    <span> / night</span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge rounded-pill text-bg-info"
                                          title="Bookings">
                                        <i class="fa fa-calendar me-1"/>
                                        <field name="booking_count"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
