<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================== -->
    <!--       SECURITY GROUPS          -->
    <!-- ============================== -->

    <record id="module_category_hotel" model="ir.module.category">
        <field name="name">Hotel Management</field>
        <field name="description">Category for Hotel Management module</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_hotel_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Hotel User: Can view and create rooms, guests, and bookings.</field>
    </record>

    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
        <field name="comment">Hotel Manager: Full access to all hotel operations including configuration and reporting.</field>
    </record>

</odoo>
